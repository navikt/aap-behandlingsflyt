<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="pretty" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%cyan(%d{HH:mm:ss.SSS}) %gray([%thread]) %highlight(%-5level) %magenta(%logger{36}) [jobb='%X{jobbType}', sakId='%X{sakId}', behandlingId='%X{behandlingId}'] - %msg%n
            </pattern>
        </encoder>
    </appender>

    <appender name="auditLogger" class="ch.qos.logback.core.ConsoleAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <pattern>%m%n%xEx</pattern>
        </layout>
    </appender>

    <logger level="ERROR" name="auditLogger" additivity="false">
        <appender-ref ref="auditLogger"/>
    </logger>

    <root level="ERROR">
        <appender-ref ref="pretty"/>
    </root>

    <logger level="ERROR" name="team-logs"  additivity="false">
        <appender-ref ref="pretty"/>
    </logger>

    <logger level="INFO" name="io.netty"  />
    <logger level="INFO" name="org.postgresql"/>
    <logger level="INFO" name="com.zaxxer.hikari"/>
    <logger level="INFO" name="no.nav.aap.motor"/>
    <logger level="INFO" name="io.netty"  />
    <logger level="INFO" name="io.ktor.server.Application"  />

    <logger name="no.nav" level="INFO" />
    <logger name="no.nav.aap.behandlingsflyt.behandling.klage" level="TRACE" />
    <logger name="PåklagetBehandlingGrunnlagApi" level="TRACE" />

</configuration>